/public-events/.snapshot.json
/public-events/.next/
/public-events/out/
/public-events/public/data/
/public-events/next-env.d.ts
/.netlify/
/public-api/dist/

# Local Impeccable tooling
.agents/skills/impeccable/scripts/bin/
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/backups/
.impeccable/review/

# CRM Kubernetes deployment helpers
/deploy/crm/scripts/__pycache__/
