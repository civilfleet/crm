generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Organization {
  id                      String      @id @default(uuid()) @unique 
  name                    String?      @db.VarChar(255)          
  address                 String?      @db.VarChar(255)          
  email                   String       @db.VarChar(255)   @unique                       
  phone                   String?      @db.VarChar(255)                         
  postalCode              String?      @db.VarChar(255)  
  city                    String?      @db.VarChar(255)  
  country                 String?      @db.VarChar(255)  
  website                 String?      @db.VarChar(255)
  taxID                   String?      @db.VarChar(255)
  isFilledByOrg           Boolean      @default(false)
  portalAccessEnabled     Boolean      @default(false)
  bankDetailsId           String?      @unique
  orgTypeId               String?
  orgType                 OrganizationType? @relation(fields: [orgTypeId], references: [id], onDelete: SetNull)
  profileData             Json?
  contactPersonId         String?
  contactPerson           Contact?   @relation("OrganizationContactPerson", fields: [contactPersonId], references: [id], onDelete: SetNull)
  contacts                ContactOrganization[]
  users                   User[] @relation("OrganizationUsers") // Many-to-Many relation
  teamId                  String?     
  team                    Teams?              @relation(fields: [teamId], references: [id])   
  bankDetails             BankDetails?        @relation(fields: [bankDetailsId], references: [id])
  fundingRequests         FundingRequest[]                
  Files                   File[]                    
  donationAgreements      DonationAgreement[]
  engagements             OrganizationEngagement[]
  fieldValues             OrganizationFieldValue[]
  

  createdAt               DateTime    @default(now()) @db.Timestamptz(6) 
  updatedAt               DateTime    @updatedAt @db.Timestamptz(6) 


  Transaction Transaction[]
  fileDownloadAudits FileDownloadAudit[]
}


model BankDetails {
  id              String     @id @default(uuid()) @unique       
  bankName        String     @db.VarChar(255)                  
  accountHolder   String     @db.VarChar(255)                  
  iban            String     @db.VarChar(255)     @unique                
  bic             String     @db.VarChar(255)                
  createdAt       DateTime @default(now()) @db.Timestamptz(6) 
  updatedAt       DateTime @updatedAt @db.Timestamptz(6) 
  organization    Organization? @relation
  teams           Teams? @relation 
}



enum FundingStatus {
  Submitted
  Accepted
  WaitingForSignature
  Approved
  FundsDisbursing
  Completed
  Rejected


  // remove below
  UnderReview
  Pending
  Processing 
  FundsTransferred
}
model FundingRequest {
  id                        String    @id @default(uuid()) @unique   
  name                      String      @db.VarChar(255) 
  organizationId            String                                
  organization              Organization @relation(fields: [organizationId], references: [id])
  description               String       @db.Text                   
  purpose                   String       @db.Text
  amountRequested           Decimal                                 
  amountAgreed              Decimal?                              
  remainingAmount           Decimal?    
  refinancingConcept        String       @db.Text
  sustainability            String       @db.Text
  expectedCompletionDate    DateTime                               
  status                    FundingStatus @default(Submitted)   
  submittedById             String           
  submittedBy               User? @relation(fields: [submittedById], references: [id])
  customFields              Json?                                  // Store dynamic field data as JSON
  createdAt                 DateTime @default(now()) @db.Timestamptz(6) 
  updatedAt                 DateTime @updatedAt @db.Timestamptz(6) 
  files                     File[]          
  teamId                    String?
  team                      Teams? @relation(fields: [teamId], references: [id])
  donationAgreement         DonationAgreement[]
  Transaction Transaction[]
}

model File {
  id          String    @id @default(uuid()) @unique 
  name        String?      @db.VarChar(255)  
  url         String      @unique
  type        String      @db.VarChar(255)                             
  createdBy   User @relation("CreatedByRelation", fields: [createdById], references: [id])
  createdById String                       
  updatedBy   User @relation("UpdatedByRelation", fields: [updatedById], references: [id])
  updatedById String               
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6) 

  organizationId String?  @db.VarChar(255)  
  organization   Organization? @relation(fields: [organizationId], references: [id])  // One-to-Many relation
  fundingRequestId String?
  FundingRequest FundingRequest? @relation(fields: [fundingRequestId], references: [id])
  donationAgreement DonationAgreement[]


  Transaction Transaction[]
  downloadAudits FileDownloadAudit[]

  contactId String?  @db.VarChar(255)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model PendingUpload {
  id            String    @id @default(uuid()) @unique
  key           String    @unique
  originalName  String?   @db.VarChar(255)
  contentType   String?   @db.VarChar(255)
  teamId        String
  team          Teams     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumedAt    DateTime? @db.Timestamptz(6)
  consumedByFileId String?
  expiresAt     DateTime  @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([teamId, userId, consumedAt])
  @@index([expiresAt, consumedAt])
}

enum FileDownloadType {
  SINGLE
  BULK
}

model FileDownloadAudit {
  id             String           @id @default(uuid()) @unique
  type           FileDownloadType
  fileCount      Int              @default(1)
  query          String?          @db.Text
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId         String?
  file           File?            @relation(fields: [fileId], references: [id], onDelete: SetNull)
  teamId         String?
  team           Teams?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)

  @@index([teamId, createdAt])
  @@index([organizationId, createdAt])
  @@index([fileId, createdAt])
  @@index([userId, createdAt])
}

enum Roles {
  Organization
  Team
  Admin
}

enum LoginMethod {
  EMAIL_MAGIC_LINK
  OIDC
}


model Teams {
  id          String           @id @default(uuid()) @unique
  name        String           @unique
  email       String           @db.VarChar(255) @unique
  loginDomain String?          @db.VarChar(255)
  loginMethod LoginMethod      @default(EMAIL_MAGIC_LINK)
  oidcIssuer  String?          @db.VarChar(500)
  oidcClientId String?         @db.VarChar(255)
  oidcClientSecret String?     @db.Text
  autoProvisionUsersFromOidc Boolean @default(false)
  defaultOidcGroupId String?
  defaultOidcGroup Group? @relation("DefaultOidcGroup", fields: [defaultOidcGroupId], references: [id], onDelete: SetNull)
  domainVerificationToken String? @db.VarChar(255)
  domainVerifiedAt DateTime?   @db.Timestamptz(6)
  domainLastCheckedAt DateTime? @db.Timestamptz(6)
  registrationPageLogoKey String? @db.VarChar(255)
  phone       String?          @db.VarChar(255)
  address     String?          @db.VarChar(255)
  postalCode  String?          @db.VarChar(255)
  city        String?          @db.VarChar(255)
  country     String?          @db.VarChar(255)
  website     String?          @db.VarChar(255)
  strategicPriorities String?  @db.Text
  modules     AppModule[]      @default([CRM, FUNDING])

  bankDetailsId String?        @unique
  bankDetails   BankDetails?   @relation(fields: [bankDetailsId], references: [id])
  organizations Organization[]
  organizationTypes OrganizationType[]

  users     User[] @relation("TeamUsers") // Many-to-Many relation
  fundingRequests    FundingRequest[]
  donationAgreements DonationAgreement[]
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)

  ownerId String?
  owner   User? @relation("TeamOwner", fields: [ownerId], references: [id])

  emailTemplates emailTemplates[]
  formSections FormSection[]

  Transaction Transaction[]
  contacts     Contact[]
  contactEmails ContactEmail[]
  contactLists ContactList[]
  emailBatches EmailBatch[]
  emailInboxes EmailInbox[]
  inboundEmailMessages InboundEmailMessage[]
  contactAccessReviews ContactAccessReview[]
  events       Event[]
  eventRoles   EventRole[]
  eventTypes   EventType[]
  groups       Group[]
  integrationConnections IntegrationConnection[]
  zammadGroupSettings ZammadGroupSetting[]
  zammadSyncJobs ZammadSyncJob[]
  contactFieldAccesses ContactFieldAccess[]
  organizationEngagements OrganizationEngagement[]
  fileDownloadAudits FileDownloadAudit[]
  pendingUploads PendingUpload[]
  systemLogs SystemLog[]
  engagementInboxStates ContactEngagementInboxState[]
  engagementUserStates ContactEngagementUserState[]
}

model OrganizationType {
  id        String   @id @default(uuid()) @unique
  teamId    String
  team      Teams    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(255)
  color     String?  @db.VarChar(50)
  schema    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organizations Organization[]

  @@unique([teamId, name])
  @@index([teamId])
}

model OrganizationEngagement {
  id          String   @id @default(uuid()) @unique
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId      String
  team        Teams    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(100)
  note        String?  @db.Text
  engagedAt   DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([organizationId])
  @@index([teamId])
  @@index([engagedAt])
}

model OrganizationFieldValue {
  id             String   @id @default(uuid()) @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String   @db.VarChar(255)
  type           String   @db.VarChar(50)
  stringValue    String?  @db.Text
  numberValue    Decimal?
  dateValue      DateTime? @db.Timestamptz(6)
  booleanValue   Boolean?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, key])
  @@index([key])
  @@index([organizationId])
}

model IntegrationConnection {
  id            String               @id @default(uuid()) @unique
  teamId        String
  team          Teams                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  provider      IntegrationProvider
  apiKey        String               @db.Text
  baseUrl       String?              @db.VarChar(500)
  webhookSecret String?              @db.Text
  defaultListId String?              @db.VarChar(255)
  senderEmail   String?              @db.VarChar(255)
  senderName    String?              @db.VarChar(255)
  isEnabled     Boolean              @default(true)
  lastSyncedAt  DateTime?            @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  @@unique([teamId, provider])
}

model ZammadGroupSetting {
  id                 String   @id @default(uuid()) @unique
  teamId             String
  team               Teams    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  groupId            Int
  groupName          String   @db.VarChar(255)
  importEnabled      Boolean  @default(false)
  autoCreateContacts Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  @@unique([teamId, groupId])
  @@index([teamId])
}

model ZammadSyncJob {
  id          String              @id @default(uuid()) @unique
  teamId      String
  team        Teams               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type        ZammadSyncJobType
  status      ZammadSyncJobStatus @default(PENDING)
  ticketId    Int?
  payload     Json?
  result      Json?
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  runAfter    DateTime            @default(now()) @db.Timestamptz(6)
  lockedAt    DateTime?           @db.Timestamptz(6)
  lockedBy    String?             @db.VarChar(255)
  startedAt   DateTime?           @db.Timestamptz(6)
  finishedAt  DateTime?           @db.Timestamptz(6)
  lastError   String?             @db.Text
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  @@index([status, runAfter])
  @@index([teamId, status])
  @@index([lockedAt])
}

model User {
  id             String           @id @default(uuid()) @unique
  name           String?          @db.VarChar(255)
  address        String?          @db.VarChar(255)
  email          String           @db.VarChar(255) @unique
  phone          String?          @db.VarChar(255)
  postalCode     String?          @db.VarChar(255)
  city           String?          @db.VarChar(255)
  country        String?          @db.VarChar(255)
  roles          Roles[]
  emailVerified DateTime?
  image         String?

  fundingRequests FundingRequest[]
  teams           Teams[]          @relation("TeamUsers") // Many-to-Many relation
  organizations   Organization[]   @relation("OrganizationUsers") // Many-to-Many relation
  groups          UserGroup[]      // Many-to-Many relation through UserGroup
  ownedTeams      Teams[]          @relation("TeamOwner")

  signedAgreements DonationAgreementSignature[]
  donationAgreement DonationAgreement[] @relation("CreatedByRelation")

  createdBy       File[]           @relation("CreatedByRelation") // One-to-Many relation
  updatedBy       File[]           @relation("UpdatedByRelation") // One-to-Many relation
  fileDownloadAudits FileDownloadAudit[]
  pendingUploads PendingUpload[]
  accounts      Account[]
  sessions      Session[]
  engagementInboxStates ContactEngagementInboxState[]
  engagementUserStates ContactEngagementUserState[]


  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  lastLoginAt    DateTime?        @db.Timestamptz(6)

}

model DonationAgreement {
  id               String    @id @default(uuid()) @unique
  fundingRequestId String
  fundingRequest   FundingRequest @relation(fields: [fundingRequestId], references: [id])

  fileId           String
  file             File      @relation(fields: [fileId], references: [id])
  agreement        String    @db.Text

  createdBy        User @relation("CreatedByRelation", fields: [createdById], references: [id])
  createdById      String
  userSignatures DonationAgreementSignature[]
  teamId           String?
  team             Teams? @relation(fields: [teamId], references: [id])
  organizationId           String?
  organization             Organization? @relation(fields: [organizationId], references: [id])

  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
}

model DonationAgreementSignature {
  donationAgreementId String
  userId              String
  signedAt            DateTime?  // If NULL, person hasn't signed

  donationAgreement DonationAgreement @relation(fields: [donationAgreementId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([donationAgreementId, userId]) // Composite key to avoid duplicate signatures
}

enum ContactAttributeType {
  STRING
  NUMBER
  DATE
  LOCATION
}

enum AppModule {
  CRM
  FUNDING
  ADMIN
}

enum IntegrationProvider {
  KLAVIYO
  ZAMMAD
  SCALEWAY_TEM
}

enum EmailBatchStatus {
  SENDING
  SENT
  PARTIAL
  FAILED
}

enum EmailRecipientStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
  DELIVERED
  BOUNCED
}

enum ZammadSyncJobType {
  INCREMENTAL_SYNC
  FULL_SYNC
  TICKET_SYNC
}

enum ZammadSyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ContactGender {
  FEMALE
  MALE
  NON_BINARY
  OTHER
  NO_ANSWER
}

enum ContactRequestPreference {
  YES
  NO
  NO_ANSWER
}

enum ContactEmailKind {
  PRIMARY
  ALIAS
  SHARED
}

model Contact {
  id                String               @id @default(uuid()) @unique
  teamId            String
  team              Teams                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name              String
  pronouns          String?             @db.VarChar(120)
  gender            ContactGender?
  genderRequestPreference  ContactRequestPreference?
  isBipoc           Boolean?
  racismRequestPreference  ContactRequestPreference?
  otherMargins      String?             @db.Text
  onboardingDate    DateTime?            @db.Timestamptz(6)
  breakUntil        DateTime?            @db.Timestamptz(6)
  address           String?             @db.VarChar(255)
  postalCode        String?             @db.VarChar(255)
  state             String?             @db.VarChar(255)
  city              String?             @db.VarChar(255)
  country           String?             @db.VarChar(255)
  countryCode       String?             @db.Char(2)
  latitude          Decimal?            @db.Decimal(9, 6)
  longitude         Decimal?            @db.Decimal(9, 6)
  phone             String?              @db.VarChar(255)
  signal            String?              @db.VarChar(255)
  website           String?             @db.VarChar(255)
  notes             String?             @db.Text
  groupId           String?              // Optional group for access control
  group             Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?            @db.Timestamptz(6)
  emails            ContactEmail[]
  attributes        ContactAttribute[]
  socialLinks       ContactSocialLink[]
  events            EventContact[]
  registrations     EventRegistration[]
  engagements       ContactEngagement[]
  emailRecipients   EmailRecipient[]
  inboundEmailMessages InboundEmailMessage[]
  contactAccessReviews ContactAccessReview[]
  changeLogs        ContactChangeLog[]
  lists             ContactListMember[]
  organizationsAsContactPerson Organization[] @relation("OrganizationContactPerson")
  organizations     ContactOrganization[]
  files             File[]
  groups            ContactGroup[]

  @@index([groupId])
  @@index([teamId, groupId])
  @@index([teamId, deletedAt])
}

model ContactEmail {
  id        String           @id @default(uuid()) @unique
  teamId    String
  team      Teams            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email     String           @db.VarChar(255)
  kind      ContactEmailKind
  label     String?          @db.VarChar(120)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)

  @@index([teamId, email])
  @@index([contactId])
  @@index([kind])
  @@unique([contactId, email])
}

model ContactOrganization {
  contactId      String
  organizationId String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  @@id([contactId, organizationId])
  @@index([organizationId])
}

model ContactGroup {
  contactId String
  groupId   String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([contactId, groupId])
  @@index([contactId])
  @@index([groupId])
}

model EmailBatch {
  id          String              @id @default(uuid()) @unique
  teamId      String
  team        Teams               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  provider    IntegrationProvider
  subject     String              @db.VarChar(500)
  html        String              @db.Text
  text        String?             @db.Text
  bccEmails   String[]            @default([])
  internalCopyMode String         @default("summary") @db.VarChar(32)
  internalCopySentAt DateTime?    @db.Timestamptz(6)
  senderEmail String?             @db.VarChar(255)
  senderName  String?             @db.VarChar(255)
  status      EmailBatchStatus    @default(SENDING)
  requestedCount Int              @default(0)
  sentCount      Int              @default(0)
  skippedCount   Int              @default(0)
  failedCount    Int              @default(0)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  runAfter    DateTime            @default(now()) @db.Timestamptz(6)
  lockedAt    DateTime?           @db.Timestamptz(6)
  lockedBy    String?             @db.VarChar(255)
  startedAt   DateTime?           @db.Timestamptz(6)
  lastError   String?             @db.Text
  userId      String?
  userName    String?             @db.VarChar(255)
  recipients  EmailRecipient[]
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  completedAt DateTime?           @db.Timestamptz(6)

  @@index([teamId, createdAt])
  @@index([status, runAfter])
  @@index([teamId, status])
  @@index([lockedAt])
}

model EmailRecipient {
  id          String                @id @default(uuid()) @unique
  batchId     String
  batch       EmailBatch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  email       String                @db.VarChar(255)
  name        String?               @db.VarChar(255)
  status      EmailRecipientStatus  @default(PENDING)
  providerMessageId String?         @db.VarChar(255)
  errorMessage String?              @db.Text
  sentAt      DateTime?             @db.Timestamptz(6)
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(6)

  @@index([batchId])
  @@index([contactId])
  @@index([email])
  @@index([status])
}

enum ContactAccessReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum SystemLogLevel {
  INFO
  WARN
  ERROR
}

model EmailInbox {
  id           String   @id @default(uuid()) @unique
  teamId       String
  team         Teams    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name         String   @db.VarChar(255)
  host         String   @db.VarChar(255)
  port         Int
  secure       Boolean  @default(true)
  username     String   @db.VarChar(255)
  passwordEncrypted String @db.Text
  mailbox      String   @default("INBOX") @db.VarChar(255)
  outboundMode EmailInboxOutboundMode @default(DISABLED)
  replyFromEmail String? @db.VarChar(255)
  replyFromName String? @db.VarChar(255)
  smtpHost String? @db.VarChar(255)
  smtpPort Int?
  smtpSecure Boolean @default(false)
  smtpUsername String? @db.VarChar(255)
  smtpPasswordEncrypted String? @db.Text
  autoApproveExistingVisible Boolean @default(true)
  requireReviewForHiddenMatches Boolean @default(true)
  allowCreateContacts Boolean @default(false)
  allowedDomains String[] @default([])

  isEnabled    Boolean  @default(true)
  lastSyncedAt DateTime? @db.Timestamptz(6)
  uidValidity  BigInt?
  lastUid      BigInt?
  syncLockedAt DateTime? @db.Timestamptz(6)
  syncLockedBy String? @db.VarChar(255)
  lastSyncError String? @db.Text

  messages     InboundEmailMessage[]
  sentEngagements ContactEngagement[]
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@index([teamId])
  @@index([groupId])
  @@index([isEnabled])
  @@index([syncLockedAt])
}

enum EmailInboxOutboundMode {
  DISABLED
  SMTP
  SCALEWAY
}

model InboundEmailMessage {
  id            String   @id @default(uuid()) @unique
  teamId        String
  team          Teams    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  emailInboxId  String
  emailInbox    EmailInbox @relation(fields: [emailInboxId], references: [id], onDelete: Cascade)

  mailbox       String   @db.VarChar(255)
  uidValidity   BigInt
  uid           BigInt
  messageId     String?  @db.VarChar(500)

  fromEmail     String   @db.VarChar(255)
  fromName      String?  @db.VarChar(255)
  subject       String?  @db.VarChar(500)
  body          String   @db.Text
  receivedAt    DateTime @db.Timestamptz(6)

  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  engagementId  String?
  engagement    ContactEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  accessReviews ContactAccessReview[]
  rawHeaders    Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([emailInboxId, mailbox, uidValidity, uid])
  @@index([teamId, fromEmail])
  @@index([groupId])
  @@index([messageId])
  @@index([contactId])
  @@index([engagementId])
}

model ContactAccessReview {
