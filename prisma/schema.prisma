  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id            String              @id @default(uuid()) @unique
  teamId        String
  team          Teams               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  eventTypeId   String?
  eventType     EventType?          @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  title         String              @db.VarChar(255)
  slug          String?             @db.VarChar(255)
  description   String?             @db.Text
  location      String?             @db.VarChar(255)
  isOnline      Boolean             @default(false)
  expectedGuests Int?
  hasRemuneration Boolean            @default(false)
  address       String?             @db.VarChar(255)
  city          String?             @db.VarChar(255)
  postalCode    String?             @db.VarChar(255)
  state         String?             @db.VarChar(255)
  timeZone      String?             @db.VarChar(255)
  merchNeeded   Boolean             @default(false)
  startDate     DateTime            @db.Timestamptz(6)
  endDate       DateTime?           @db.Timestamptz(6)
  isPublic      Boolean             @default(false)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)
  contacts      EventContact[]
  lists         EventList[]
  registrations EventRegistration[]

  @@unique([teamId, slug])
  @@index([teamId])
  @@index([slug])
}

model EventList {
  eventId   String
  listId    String
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  @@id([eventId, listId])
  @@index([eventId])
  @@index([listId])
}

model EventType {
  id        String    @id @default(uuid()) @unique
  teamId    String
  team      Teams     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(255)
  color     String?   @db.VarChar(50)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  events    Event[]

  @@unique([teamId, name])
  @@index([teamId])
}

model EventContact {
  eventId      String
  contactId    String
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  roles        EventContactRole[]

  @@id([eventId, contactId])
  @@index([eventId])
  @@index([contactId])
}

model EventContactRole {
  eventId      String
  contactId    String
  eventRoleId  String
  eventContact EventContact @relation(fields: [eventId, contactId], references: [eventId, contactId], onDelete: Cascade)
  eventRole    EventRole    @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)

  @@id([eventId, contactId, eventRoleId])
}

model EventRole {
  id        String    @id @default(uuid()) @unique
  teamId    String
  team      Teams     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(255)
  color     String?   @db.VarChar(50)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  contacts  EventContactRole[]

  @@unique([teamId, name])
  @@index([teamId])
}

model EventRegistration {
  id          String   @id @default(uuid()) @unique
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  phone       String?  @db.VarChar(255)
  notes       String?  @db.Text
  customData  Json?    // Store additional registration form data as JSON
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([eventId])
  @@index([email])
  @@index([contactId])
}

enum EngagementDirection {
  INBOUND   // Message received by contact
  OUTBOUND  // Message sent to contact
}

enum EngagementSource {
  EMAIL
  PHONE
  SMS
  MEETING
  EVENT
  TODO
  NOTE
  OTHER
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContactSubmodule {
  SUPERVISION
  EVENTS
  SHOP
}

model ContactEngagement {
  id          String               @id @default(uuid()) @unique
  contactId   String
  contact     Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  teamId      String
  direction   EngagementDirection
  source      EngagementSource
  subject     String?              @db.VarChar(500)
  message     String               @db.Text
  userId      String?              // Team user who sent/received the message
  userName    String?              @db.VarChar(255) // Store name for display even if user deleted
  externalId  String?              @db.VarChar(255)
  externalSource String?           @db.VarChar(255)
  emailInboxId String?
  emailInbox EmailInbox? @relation(fields: [emailInboxId], references: [id], onDelete: SetNull)
  replyToEngagementId String?
  replyToEngagement ContactEngagement? @relation("EngagementReplies", fields: [replyToEngagementId], references: [id], onDelete: SetNull)
  replies ContactEngagement[] @relation("EngagementReplies")
  restrictedToSubmodule ContactSubmodule?

  // Todo-specific fields
  assignedToUserId String?          // User assigned to complete the todo
  assignedToUserName String?        @db.VarChar(255)
  todoStatus      TodoStatus?       // Status of the todo (only for TODO source)
  dueDate         DateTime?         @db.Timestamptz(6) // Due date for todos

  engagedAt   DateTime             @db.Timestamptz(6) // When the engagement occurred
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(6)
  inboundEmailMessages InboundEmailMessage[]
  userStates ContactEngagementUserState[]

  @@index([contactId])
  @@index([teamId])
  @@index([emailInboxId])
  @@index([replyToEngagementId])
  @@index([engagedAt])
  @@index([assignedToUserId])
  @@index([todoStatus])
  @@unique([teamId, externalId, externalSource])
}

model ContactEngagementInboxState {
  teamId        String
  team          Teams    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  initializedAt DateTime @default(now()) @db.Timestamptz(6)
  readThroughAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@id([teamId, userId])
  @@index([userId])
}

model ContactEngagementUserState {
  teamId      String
  team        Teams            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagementId String
  engagement  ContactEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  isRead      Boolean
  dismissedAt DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  @@id([engagementId, userId])
  @@index([teamId, userId, isRead])
  @@index([teamId, userId, dismissedAt])
  @@index([userId])
}

enum ChangeAction {
  CREATED
  UPDATED
  DELETED
}

model ContactChangeLog {
  id          String       @id @default(uuid()) @unique
  contactId   String
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  action      ChangeAction
  fieldName   String?      @db.VarChar(255) // Field that changed (null for CREATE/DELETE)
  oldValue    String?      @db.Text         // Previous value (JSON for complex types)
  newValue    String?      @db.Text         // New value (JSON for complex types)
  metadata    Json?
  userId      String?      // User who made the change
  userName    String?      @db.VarChar(255) // Store name for display
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  @@index([contactId])
  @@index([createdAt])
}

// Group and UserGroup models for access control
model Group {
  id                    String      @id @default(uuid()) @unique
  teamId                String
  team                  Teams       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name                  String      @db.VarChar(255)
  description           String?     @db.Text
  canAccessAllContacts  Boolean     @default(false)  // If true, users in this group can see all contacts
  isDefaultGroup        Boolean     @default(false)
  modulePermissions     GroupModulePermission[]
  createdAt             DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(6)

  users       UserGroup[]
  contacts    Contact[]
  contactGroups ContactGroup[]
  contactFieldAccesses ContactFieldAccess[]
  emailInboxes EmailInbox[]
  inboundEmailMessages InboundEmailMessage[]
  contactAccessReviews ContactAccessReview[]
  teamsDefaultOidcFor Teams[] @relation("DefaultOidcGroup")

  @@unique([teamId, name])
  @@index([teamId])
  @@index([teamId, isDefaultGroup])
}

model UserGroup {
  userId    String
  groupId   String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model GroupModulePermission {
  id        String    @id @default(uuid()) @unique
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  module    AppModule
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([groupId, module])
  @@index([groupId])
}
